# Server Configuration
HOST=0.0.0.0
PORT=8000

# OAuth Configuration
CALLBACK_PORT=8085
# For cloud deployment, set the full callback URL:
# CALLBACK_URL=https://your-app.onrender.com/callback

# Google Credentials (alternative to credentials.json file)
# GOOGLE_CREDENTIALS_JSON={"web":{"client_id":"...","client_secret":"...",...}}

# Client Configuration
GEMINI_API_KEY=your-gemini-api-key

# MCP Server URL (for client)
MCP_SERVER_URL=http://localhost:8000/mcp